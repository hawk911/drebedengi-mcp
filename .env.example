# Скопируйте в .env и заполните. Файл .env не должен попадать в git.
DREBEDENGI_LOGIN=you@example.com
DREBEDENGI_PASSWORD=your-password
# API ID от поддержки drebedengi. Публичный demo_api работает только
# с демо-аккаунтом demo@example.com / demo.
DREBEDENGI_API_ID=your_api_id
# Счёт по умолчанию для add_expense/add_income (необязательно)
# DREBEDENGI_DEFAULT_ACCOUNT=Кошелёк
# 1 — только чтение: инструменты записи не регистрируются
# DREBEDENGI_READONLY=0
# Пауза между запросами к API, мс (сервис просит не создавать поток запросов)
# DREBEDENGI_MIN_INTERVAL_MS=1000
